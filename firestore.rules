rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsWorkspace(workspaceId) {
      return signedIn() && request.auth.uid == workspaceId;
    }

    match /workspaces/{workspaceId} {
      allow read: if ownsWorkspace(workspaceId);

      allow create: if ownsWorkspace(workspaceId)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.id == workspaceId;

      allow update: if ownsWorkspace(workspaceId)
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.id == workspaceId;

      // Workspaces are intentionally never deleted from the client.
      allow delete: if false;

      // Every nested SolProvo collection is workspace-scoped.
      // This covers prospects, leads, activities, audits, demos,
      // appointments, customers, and future collections.
      match /{collectionName}/{documentId} {
        allow read: if ownsWorkspace(workspaceId);

        allow create, update: if ownsWorkspace(workspaceId)
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.workspaceId == workspaceId;

        allow delete: if ownsWorkspace(workspaceId)
          && resource.data.ownerId == request.auth.uid;
      }
    }
  }
}
